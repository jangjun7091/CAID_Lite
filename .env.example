# ── Active provider selection ─────────────────────────────────────────────────
# Overrides the `provider` and `model` keys in config/default.yaml at runtime.
LLM_PROVIDER=qwen
LLM_MODEL=qwen3-coder-30b-a3b-instruct

# ── Qwen3-Coder (default) ─────────────────────────────────────────────────────
# DashScope cloud endpoint (default):
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=your_dashscope_key_here
# Alternatively, point to OpenRouter or a self-hosted vLLM instance:
# QWEN_API_BASE=https://openrouter.ai/api/v1
# QWEN_API_KEY=your_openrouter_key_here

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Local OpenAI-compatible server (vLLM / LM Studio / Ollama) ───────────────
# Leave LOCAL_API_KEY=none for servers that don't require authentication.
LOCAL_API_BASE=http://localhost:8000/v1
LOCAL_API_KEY=none
